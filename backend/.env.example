# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/followup

# --- Google OAuth (Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# --- App ---
FRONTEND_URL=http://localhost:3000
POST_LOGIN_PATH=/
# JWT signing key:   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Fernet key for encrypting refresh tokens:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
COOKIE_SECURE=false

# --- LLM ---
GROQ_API_KEY=
LLM_MODEL=

# --- Email scanning ---
EMAIL_LOOKBACK_DAYS=5
MAX_THREADS=50
EXCLUDE_PROMOTIONS=true
